    <!-- http://www.semanticweb.org/PrOntoNarr#hasPoliticalAffiliation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#hasPoliticalAffiliation">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#Speaker"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#hasPoliticalBackground -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#hasPoliticalBackground">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#Speaker"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#hostedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#hostedBy">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#Source"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/PrOntoNarr#Platform"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#isATechniqueUseIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#isATechniqueUseIn">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#usesTechnique"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#PropagandaTechnique"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/PrOntoNarr#PropagandaText"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#isComprisedIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#isComprisedIn">
