    <!-- http://www.semanticweb.org/PrOntoNarr#belongsTo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#belongsTo">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#hasComponent"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeComponent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeSchema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#belongsTo_AmericanDream -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#belongsTo_AmericanDream">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#belongsTo"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#hasComponent"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#hasComponent_AmericanDream"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeComponent"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#AD_Condition"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#AD_Example"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#AD_Promise"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#AD_Solution"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#AD_Threats"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/PrOntoNarr#AmericanDream"/>
        <rdfs:comment>Mutual dignity and coexistence</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#belongsTo_HerosJourney -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#belongsTo_HerosJourney">
