        <PrOntoNarr:containsElement rdf:resource="http://www.semanticweb.org/PrOntoNarr#Challenge_3"/>
        <PrOntoNarr:containsElement rdf:resource="http://www.semanticweb.org/PrOntoNarr#Challenge_4"/>
