        <rdfs:range rdf:resource="http://www.semanticweb.org/PrOntoNarr#PropagandaCampaigns"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#isTheArchetypeOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#isTheArchetypeOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#Archetype"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/PrOntoNarr#Agent"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#isTheEffectEvokedIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#isTheEffectEvokedIn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#PersuasiveEffect"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/PrOntoNarr#PropagandaText"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#isTheNarrativeOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#isTheNarrativeOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeText"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#Paragraph"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/PrOntoNarr#PropagandaText"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#isTheParagraphOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#isTheParagraphOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#Paragraph"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/PrOntoNarr#PropagandaText"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#isUsedIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#isUsedIn">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#useSchema"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeSchema"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeText"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#procedes -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#procedes">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeComponent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeComponent"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#refersTo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#refersTo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeElement"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeSchema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#retrievedFrom -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#retrievedFrom">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#PropagandaText"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/PrOntoNarr#Source"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#useSchema -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#useSchema">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeText"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeSchema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#usesTechnique -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#usesTechnique">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#PropagandaText"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/PrOntoNarr#PropagandaTechnique"/>
    </owl:ObjectProperty>
    


