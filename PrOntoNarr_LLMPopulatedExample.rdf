        <rdfs:comment>First Minister of Scotland</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#TAConflict_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/PrOntoNarr#TAConflict_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/PrOntoNarr#TA_Conflict"/>
        <PrOntoNarr:belongsTo_ThreeActStructure rdf:resource="http://www.semanticweb.org/PrOntoNarr#ThreeActStructure_1"/>
        <rdfs:comment>This government has consistently and unequivocally condemned the terrorist attacks carried out by Hamas on 7 October 2023, which claimed the lives of over 1,200 Israelis and saw 251 hostages taken.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#TAConflict_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/PrOntoNarr#TAConflict_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/PrOntoNarr#TA_Conflict"/>
        <PrOntoNarr:belongsTo_ThreeActStructure rdf:resource="http://www.semanticweb.org/PrOntoNarr#ThreeActStructure_2"/>
        <rdfs:comment>The Government of Israel has, however, overtly rejected this position... Israeli security Cabinet&apos;s decision to seize Gaza City... the Israeli government has paid no heed</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#TAExposition_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/PrOntoNarr#TAExposition_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/PrOntoNarr#TA_Exposition"/>
        <PrOntoNarr:belongsTo_ThreeActStructure rdf:resource="http://www.semanticweb.org/PrOntoNarr#ThreeActStructure_1"/>
        <rdfs:comment>The situation in Gaza is a man-made humanitarian catastrophe. Over 63,000 people in Gaza have been killed and many more maimed. Most of the Strip lies in ruins</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#TAExposition_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/PrOntoNarr#TAExposition_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/PrOntoNarr#TA_Exposition"/>
        <PrOntoNarr:belongsTo_ThreeActStructure rdf:resource="http://www.semanticweb.org/PrOntoNarr#ThreeActStructure_2"/>
        <rdfs:comment>recognition must not be conditional... It is the right of Palestinians</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#TAResolution_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/PrOntoNarr#TAResolution_1">
