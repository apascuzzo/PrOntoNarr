        <rdf:type rdf:resource="http://www.semanticweb.org/PrOntoNarr#PersuasiveEffect"/>
        <PrOntoNarr:deliveredBy rdf:resource="http://www.semanticweb.org/PrOntoNarr#Speaker_1"/>
        <PrOntoNarr:isTheEffectEvokedIn rdf:resource="http://www.semanticweb.org/PrOntoNarr#PropagandaText_1"/>
        <PrOntoNarr:dateTime rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2025</PrOntoNarr:dateTime>
        <PrOntoNarr:deliveredFor>Parliamentary address on Gaza situation and genocide determination</PrOntoNarr:deliveredFor>
        <PrOntoNarr:deliveredIn>Scottish Parliament</PrOntoNarr:deliveredIn>
        <rdfs:comment>Emotional appeal through vivid descriptions of suffering and statistics. Building moral authority through condemnation of all violence. Creating urgency for action through catastrophic imagery. Establishing credibility through balanced condemnation of Hamas and call for Palestinian statehood.</rdfs:comment>
    </owl:NamedIndividual>
    


