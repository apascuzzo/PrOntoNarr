        <PrOntoNarr:containsElement rdf:resource="http://www.semanticweb.org/PrOntoNarr#Event_6"/>
        <PrOntoNarr:containsElement rdf:resource="http://www.semanticweb.org/PrOntoNarr#Message_3"/>
        <PrOntoNarr:containsElement rdf:resource="http://www.semanticweb.org/PrOntoNarr#Message_4"/>
        <PrOntoNarr:containsElement rdf:resource="http://www.semanticweb.org/PrOntoNarr#PalestinianPeople_1"/>
        <PrOntoNarr:containsElement rdf:resource="http://www.semanticweb.org/PrOntoNarr#Person_1"/>
        <PrOntoNarr:containsElement rdf:resource="http://www.semanticweb.org/PrOntoNarr#Purpose_3"/>
        <PrOntoNarr:containsElement rdf:resource="http://www.semanticweb.org/PrOntoNarr#Purpose_4"/>
