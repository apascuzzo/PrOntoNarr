        <PrOntoNarr:containsElement rdf:resource="http://www.semanticweb.org/PrOntoNarr#Topic_2"/>
        <PrOntoNarr:hasComponent_AmericanDream rdf:resource="http://www.semanticweb.org/PrOntoNarr#ADCondition_1"/>
        <PrOntoNarr:hasComponent_AmericanDream rdf:resource="http://www.semanticweb.org/PrOntoNarr#ADExample_1"/>
        <PrOntoNarr:hasComponent_AmericanDream rdf:resource="http://www.semanticweb.org/PrOntoNarr#ADPromise_1"/>
        <PrOntoNarr:hasComponent_AmericanDream rdf:resource="http://www.semanticweb.org/PrOntoNarr#ADSolution_1"/>
        <PrOntoNarr:hasComponent_AmericanDream rdf:resource="http://www.semanticweb.org/PrOntoNarr#ADThreat_1"/>
        <PrOntoNarr:isUsedIn rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeText_2"/>
    </owl:NamedIndividual>
    


