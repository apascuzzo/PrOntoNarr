        <owl:inverseOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#isTheParagraphOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#PropagandaText"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/PrOntoNarr#Paragraph"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#hostedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#hostedBy">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#Source"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/PrOntoNarr#Platform"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#isATechniqueUseIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#isATechniqueUseIn">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#usesTechnique"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#PropagandaTechnique"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/PrOntoNarr#PropagandaText"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#isComprisedIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#isComprisedIn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#PropagandaText"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/PrOntoNarr#PropagandaCampaigns"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#isTheArchetypeOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#isTheArchetypeOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#Archetype"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/PrOntoNarr#Agent"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#isTheEffectEvokedIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#isTheEffectEvokedIn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#PersuasiveEffect"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/PrOntoNarr#PropagandaText"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#isTheNarrativeOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#isTheNarrativeOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeText"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#Paragraph"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#PropagandaText"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#isTheParagraphOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#isTheParagraphOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#Paragraph"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/PrOntoNarr#PropagandaText"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#isUsedIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#isUsedIn">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#useSchema"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeSchema"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeText"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#procedes -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#procedes">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeComponent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeComponent"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#refersTo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#refersTo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeElement"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeSchema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#retrievedFrom -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#retrievedFrom">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#PropagandaText"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/PrOntoNarr#Source"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#useSchema -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#useSchema">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeText"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeSchema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#usesTechnique -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#usesTechnique">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#PropagandaText"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/PrOntoNarr#PropagandaTechnique"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/PrOntoNarr#dateTime -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#dateTime">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#PropagandaText"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Date and time at which the political speech was delivered</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#deliveredFor -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#deliveredFor">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#PropagandaText"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Indicating the occasion the political speech has been delivered for</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#deliveredIn -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#deliveredIn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#PropagandaText"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#hasAffiliation -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#hasAffiliation">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#Speaker"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#hasBackground -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#hasBackground">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#Speaker"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#hasNarrativeRole -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#hasNarrativeRole">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#hasOverallGoal -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#hasOverallGoal">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#PropagandaCampaigns"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#hasUrl -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#hasUrl">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#Source"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#publicationDate -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#publicationDate">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#Source"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#publisher -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#publisher">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#Source"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#sourceTitle -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#sourceTitle">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#Source"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/PrOntoNarr#AD_Condition -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#AD_Condition">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#belongsTo_AmericanDream"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#AmericanDream"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#procedes"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#AD_Threats"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/PrOntoNarr#AD_Example"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/PrOntoNarr#AD_Promise"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/PrOntoNarr#AD_Solution"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/PrOntoNarr#AD_Threats"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#AD_Example -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#AD_Example">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#belongsTo_AmericanDream"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#AmericanDream"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#procedes"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#AD_Solution"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/PrOntoNarr#AD_Promise"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/PrOntoNarr#AD_Solution"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/PrOntoNarr#AD_Threats"/>
        <rdfs:comment>A concrete instance or story that illustrates the condition or theme, making it relatable.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#AD_Promise -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#AD_Promise">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#belongsTo_AmericanDream"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#AmericanDream"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/PrOntoNarr#AD_Solution"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/PrOntoNarr#AD_Threats"/>
        <rdfs:comment>An optimistic statement or vision that suggests a better future or achievement of goals.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#AD_Solution -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#AD_Solution">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#belongsTo_AmericanDream"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#AmericanDream"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#procedes"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#AD_Promise"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/PrOntoNarr#AD_Threats"/>
        <rdfs:comment>The means, actions, or path proposed to fulfill the promise and overcome the condition.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#AD_Threats -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#AD_Threats">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#belongsTo_AmericanDream"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#AmericanDream"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#procedes"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#AD_Example"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Obstacles, risks, or opposing forces that challenge the attainment of the promise.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#Agent -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#Agent">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#hasArchetype"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#Archetype"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>An entity capable of acting or performing tasks, including persons, organizations, and objects.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#AmericanDream -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#AmericanDream">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeSchema"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#hasComponent_AmericanDream"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#AD_Condition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#hasComponent_AmericanDream"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#AD_Example"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#hasComponent_AmericanDream"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#AD_Promise"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#hasComponent_AmericanDream"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#AD_Solution"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#hasComponent_AmericanDream"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#AD_Threats"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A narrative structure that focuses on overcoming adversity to achieve success, freedom, or prosperity, often highlighting hope, promise, and the pursuit of better opportunities.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#AppealToAuthority -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#AppealToAuthority">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#PropagandaTechnique"/>
        <rdfs:comment>Use authority’s support as evidence</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#Archetype -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#Archetype">
        <rdfs:comment>This class represents a universal model of a character, situation, or symbol that recurs in different narratives.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#ArchivalSource -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#ArchivalSource">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#Source"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#BlackAndWhiteFallacy -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#BlackAndWhiteFallacy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#PropagandaTechnique"/>
        <rdfs:comment>Present only two options among many</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#CallToAdventure -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#CallToAdventure">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#belongsTo_HerosJourney"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#HerosJourney"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#procedes"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#SupremeOrdeal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/PrOntoNarr#ReturnWithTheElixir"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/PrOntoNarr#SupremeOrdeal"/>
        <rdfs:comment>The moment when the hero is invited or compelled to leave their ordinary world and embark on a quest.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#Challenge -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#Challenge">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeElement"/>
        <rdfs:comment>A difficulty or obstacle that the protagonist or characters must face and overcome within the story.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#Dispatcher -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#Dispatcher">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#Archetype"/>
        <rdfs:comment>Sends the hero on the quest by identifying the need for action.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#Donor -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#Donor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#Archetype"/>
        <rdfs:comment>Provides the hero with an object or information that aids in the quest.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#Event -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#Event">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeElement"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#FalseHero -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#FalseHero">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#Archetype"/>
        <rdfs:comment>Claims credit for the hero&apos;s actions or seeks to marry the princess, often serving as a foil to the true hero.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#FlagWaving -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#FlagWaving">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#PropagandaTechnique"/>
        <rdfs:comment>Appeal to patriotism or identity.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#Helper -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#Helper">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#Archetype"/>
        <rdfs:comment>Assists the hero in overcoming challenges.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#Hero -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#Hero">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#Archetype"/>
        <rdfs:comment>The central character who embarks on a quest to achieve a goal.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#HerosJourney -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#HerosJourney">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeSchema"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#hasComponent_HerosJourney"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#CallToAdventure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#hasComponent_HerosJourney"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#ReturnWithTheElixir"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#hasComponent_HerosJourney"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#SupremeOrdeal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A storytelling framework describing a hero&apos;s adventure, including departure, trials, transformation, and return, emphasizing personal growth and achievement.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#InstitutionalSource -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#InstitutionalSource">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#Source"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#LoadedLanguage -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#LoadedLanguage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#PropagandaTechnique"/>
        <rdfs:comment>Appeal to emotions or stereotypes</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#MediaSource -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#MediaSource">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#Source"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#Message -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#Message">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeElement"/>
        <rdfs:comment>The underlying idea, moral, or lesson that the narrative aims to convey to the audience.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#NameCalling -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#NameCalling">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#PropagandaTechnique"/>
        <rdfs:comment>Attack an object/subject with an insulting label</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#NarrativeComponent -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#NarrativeComponent">
        <rdfs:comment>This class represents a specific part of a narrative structure.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#NarrativeElement -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#NarrativeElement">
        <rdfs:comment>This class represents any fundamental component or building block of a story, such as characters, setting, plot, conflict, or theme, that contributes to the development and structure of the narrative.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#NarrativeSchema -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#NarrativeSchema">
        <rdfs:comment>This class represent a structured framework or pattern that outlines the typical sequence and organization of events, roles, and elements within a story, helping to shape its overall meaning and flow.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#NarrativeText -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#NarrativeText">
        <rdfs:comment>This class represents a type of written text that tells a story, describing a sequence of events, often involving characters, a setting, a plot, and a clear beginning, middle, and end.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#Object -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#Object">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#Agent"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeElement"/>
        <rdfs:comment>A physical or conceptual entity that can be acted upon or that participates in processes, distinct from persons or organizations.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#Organization -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#Organization">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#Agent"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeElement"/>
        <rdfs:comment>A group or structured entity composed of multiple individuals, created for a specific purpose or goal.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#P_MainStory -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#P_MainStory">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#belongsTo_PetalStructure"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#PetalStructure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#procedes"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#P_SecondaryStories"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/PrOntoNarr#P_SecondaryStories"/>
        <rdfs:comment>The central narrative arc that drives the overall plot and focuses on the primary characters and events.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#P_SecondaryStories -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#P_SecondaryStories">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#belongsTo_PetalStructure"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#PetalStructure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Supporting subplots or side narratives that enrich the main story by exploring additional characters, themes, or perspectives.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#Paragraph -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#Paragraph">
        <rdfs:comment>This represent a paragraph of the political speech text.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#Person -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#Person">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#Agent"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeElement"/>
        <rdfs:comment>A human individual, considered as a distinct entity capable of actions and having personal identity.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#PersuasiveEffect -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#PersuasiveEffect">
        <rdfs:comment>This class represent the persuasive effect of the political speech text.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#PetalStructure -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#PetalStructure">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeSchema"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#hasComponent_PetalStructure"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#P_MainStory"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#hasComponent_PetalStructure"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#P_SecondaryStories"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A narrative model where a main story is surrounded by multiple secondary stories, each adding depth and different perspectives, like petals around a flower.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#Platform -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#Platform">
        <rdfs:comment>This represent the platforms which hosts the source</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#Princess -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#Princess">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#Archetype"/>
        <rdfs:comment>The hero&apos;s goal; often the reward for the hero&apos;s success.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#PropagandaCampaigns -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#PropagandaCampaigns">
        <rdfs:comment>This is a class that model the Propaganda campaigns.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#PropagandaTechnique -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#PropagandaTechnique">
        <rdfs:comment>This class present the propaganda techniques in the text</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#PropagandaText -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#PropagandaText">
        <rdfs:comment>This models the text of the political speech</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#Purpose -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#Purpose">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeElement"/>
        <rdfs:comment>The reason or intent behind the story, often related to what the narrative seeks to achieve or communicate.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#R_Effort -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#R_Effort">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#belongsTo_Redemption"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#Redemption"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#procedes"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#R_Return"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/PrOntoNarr#R_Remorse"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/PrOntoNarr#R_Return"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/PrOntoNarr#R_Separation"/>
        <rdfs:comment>The protagonist’s active attempts to overcome a past mistake, flaw, or wrongdoing.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#R_Remorse -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#R_Remorse">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#belongsTo_Redemption"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#Redemption"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#procedes"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#R_Effort"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/PrOntoNarr#R_Return"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/PrOntoNarr#R_Separation"/>
        <rdfs:comment>The protagonist&apos;s recognition of and regret for a past mistake or wrongdoing, which motivates the effort toward redemption.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#R_Return -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#R_Return">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#belongsTo_Redemption"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#Redemption"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/PrOntoNarr#R_Separation"/>
        <rdfs:comment>The process of coming back to a previous state, place, or community, often seeking forgiveness or reconciliation.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#R_Separation -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#R_Separation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#belongsTo_Redemption"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#Redemption"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#procedes"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#R_Remorse"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>The distancing or alienation from others caused by the protagonist’s actions or their journey toward redemption.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#Redemption -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#Redemption">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeSchema"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#hasComponent_Redemption"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#R_Effort"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#hasComponent_Redemption"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#R_Remorse"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#hasComponent_Redemption"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#R_Return"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#hasComponent_Redemption"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#R_Separation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A narrative arc centered on a protagonist&apos;s efforts to atone for past mistakes, involving remorse, struggle, separation, and eventual reconciliation or forgiveness.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#ReductionAdHitlerum -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#ReductionAdHitlerum">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#PropagandaTechnique"/>
        <rdfs:comment>Disapprove an idea suggesting it is popular with groups hated by the audience</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#ReturnWithTheElixir -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#ReturnWithTheElixir">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#belongsTo_HerosJourney"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#HerosJourney"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/PrOntoNarr#SupremeOrdeal"/>
        <rdfs:comment>The hero comes back to their ordinary world carrying a valuable lesson, treasure, or power gained from the journey, which can benefit others.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#SocialSource -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#SocialSource">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#Source"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#Solution -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#Solution">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeElement"/>
        <rdfs:comment>The action, decision, or event that resolves the central conflict or problem in the story.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#Source -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#Source">
        <rdfs:comment>This represent the source (archival, social, media posts, institutional, etc.) from which the political speech was retrieved</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#Speaker -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#Speaker">
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/PrOntoNarr#Agent"/>
        <rdfs:comment>This represent the speaker who delivers the speech</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#SupremeOrdeal -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#SupremeOrdeal">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#belongsTo_HerosJourney"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#HerosJourney"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#procedes"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#ReturnWithTheElixir"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>The hero&apos;s greatest challenge or crisis, often a life-or-death confrontation that tests their resolve and skills.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#TA_Conflict -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#TA_Conflict">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#belongsTo_ThreeActStructure"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#ThreeActStructure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#procedes"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#TA_Resolution"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/PrOntoNarr#TA_Exposition"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/PrOntoNarr#TA_Resolution"/>
        <rdfs:comment>The central struggle or problem that drives the plot and challenges the protagonist.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#TA_Exposition -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#TA_Exposition">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#belongsTo_ThreeActStructure"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#ThreeActStructure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#procedes"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#TA_Conflict"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/PrOntoNarr#TA_Resolution"/>
        <rdfs:comment>The introduction of the story’s setting, characters, and initial situation, establishing the background.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#TA_Resolution -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#TA_Resolution">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#belongsTo_ThreeActStructure"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#ThreeActStructure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>The conclusion where the conflict is resolved and the story’s outcomes are revealed.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#ThemDefinition -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#ThemDefinition">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#belongsTo_UsVsThem"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#UsVsThem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#procedes"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#UsVsThemConflict"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/PrOntoNarr#UsDefinition"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/PrOntoNarr#UsVsThemConflict"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/PrOntoNarr#UsVsThemSolution"/>
        <rdfs:comment>The identification and characterization of the opposing group or entity perceived as different or antagonistic.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#ThreeActStructure -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#ThreeActStructure">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeSchema"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#hasComponent_ThreeActStructure"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#TA_Conflict"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#hasComponent_ThreeActStructure"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#TA_Exposition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#hasComponent_ThreeActStructure"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#TA_Resolution"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A classic plot framework dividing a story into three parts: exposition (introduction), conflict (development), and resolution (conclusion).</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#Topic -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#Topic">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeElement"/>
        <rdfs:comment>The subject matter or main theme around which the story is centered.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#UsDefinition -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#UsDefinition">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#belongsTo_UsVsThem"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#UsVsThem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#procedes"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#ThemDefinition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/PrOntoNarr#UsVsThemConflict"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/PrOntoNarr#UsVsThemSolution"/>
        <rdfs:comment>The description of the in-group or protagonists, highlighting their values, identity, and unity.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#UsVsThem -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#UsVsThem">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeSchema"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#hasComponent_UsVsThem"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#ThemDefinition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#hasComponent_UsVsThem"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#UsDefinition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#hasComponent_UsVsThem"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#UsVsThemConflict"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#hasComponent_UsVsThem"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#UsVsThemSolution"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A narrative schema highlighting opposition between two groups or entities, focusing on identity, conflict, and the resolution of tensions between “us” and “them.”</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#UsVsThemConflict -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#UsVsThemConflict">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#belongsTo_UsVsThem"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#UsVsThem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#procedes"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#UsVsThemSolution"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/PrOntoNarr#UsVsThemSolution"/>
        <rdfs:comment>The tension or struggle arising from differences, opposition, or competition between “us” and “them.”</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#UsVsThemSolution -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#UsVsThemSolution">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#belongsTo_UsVsThem"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#UsVsThem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>The resolution or outcome aimed at overcoming the conflict, which may involve reconciliation, victory, or compromise.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#Villain -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#Villain">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#Archetype"/>
        <rdfs:comment>The antagonist who opposes the hero&apos;s quest.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#W_EmotionalFall -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#W_EmotionalFall">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#belongsTo_WavePlot"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#WavePlot"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#procedes"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#W_EmotionalRise"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/PrOntoNarr#W_EmotionalRise"/>
        <rdfs:comment>A period in the narrative where the protagonist experiences setbacks, disappointment, or a decline in emotional state.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#W_EmotionalRise -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#W_EmotionalRise">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#belongsTo_WavePlot"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#WavePlot"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>The subsequent recovery or improvement in the protagonist’s emotions, often leading to growth or resolution.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/PrOntoNarr#WavePlot -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#WavePlot">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeSchema"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#hasComponent_WavePlot"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#W_EmotionalFall"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#hasComponent_WavePlot"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#W_EmotionalRise"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A storytelling pattern characterized by alternating emotional highs and lows, showing the protagonist&apos;s journey through setbacks and recoveries.</rdfs:comment>
    </owl:Class>



    <!--
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Added in v2: missing inverse object properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#follows">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#procedes"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeComponent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeComponent"/>
        <rdfs:comment>Inverse of procedes: a narrative component that comes after another one in the schema.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#isSourceOf">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#retrievedFrom"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#Source"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/PrOntoNarr#PropagandaText"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/PrOntoNarr#hosts">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#hostedBy"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/PrOntoNarr#Platform"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/PrOntoNarr#Source"/>
    </owl:ObjectProperty>



    <!--
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Added in v2: missing classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <!-- Propp's seventh sphere of action -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#PrincessFather">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#Archetype"/>
        <rdfs:comment>The sought-for person&apos;s father (or guardian), who sets the hero difficult tasks, recognises the true hero and exposes the false hero.</rdfs:comment>
    </owl:Class>

    <!-- "setting" is named in the NarrativeElement comment but had no class -->

    <owl:Class rdf:about="http://www.semanticweb.org/PrOntoNarr#Setting">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/PrOntoNarr#NarrativeElement"/>
        <rdfs:comment>The time and place in which the story&apos;s events unfold, including their social and historical context.</rdfs:comment>
    </owl:Class>
















    <!--
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Added in v2: disjointness axioms
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <!-- Top-level classes (Agent left out on purpose: it overlaps with NarrativeElement) -->

    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#Archetype"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#NarrativeComponent"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#NarrativeElement"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#NarrativeSchema"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#NarrativeText"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#Paragraph"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#PersuasiveEffect"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#Platform"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#PropagandaCampaigns"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#PropagandaTechnique"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#PropagandaText"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#Source"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#Speaker"/>
        </owl:members>
    </rdf:Description>

    <!-- Narrative schemas -->

    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#AmericanDream"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#HerosJourney"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#PetalStructure"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#Redemption"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#ThreeActStructure"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#UsVsThem"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#WavePlot"/>
        </owl:members>
    </rdf:Description>

    <!-- Propp archetypes (one Agent can still have several archetypes via hasArchetype) -->

    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#Dispatcher"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#Donor"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#FalseHero"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#Helper"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#Hero"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#Princess"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#PrincessFather"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#Villain"/>
        </owl:members>
    </rdf:Description>

    <!-- Kinds of agent -->

    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#Object"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#Organization"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#Person"/>
        </owl:members>
    </rdf:Description>
    


    <!--
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Added in v3: transitive closure and ordering constraints for procedes / follows
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <!-- AmericanDream: AD_Condition -->

    <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#AD_Condition">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#procedes"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#AD_Example"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#procedes"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#AD_Solution"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#procedes"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#AD_Promise"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </rdf:Description>

    <!-- AmericanDream: AD_Threats -->

    <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#AD_Threats">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#procedes"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#AD_Solution"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#procedes"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#AD_Promise"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#follows"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#AD_Condition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#procedes"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:complementOf>
                        <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#AD_Condition"/>
                        </owl:complementOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </rdf:Description>

    <!-- AmericanDream: AD_Example -->

    <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#AD_Example">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#procedes"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#AD_Promise"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#follows"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#AD_Condition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#follows"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/PrOntoNarr#AD_Threats"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/PrOntoNarr#procedes"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:complementOf>
                        <owl:Class>
                            <owl:unionOf rdf:parseType="Collection">
                                <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#AD_Condition"/>
                                <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#AD_Threats"/>
                            </owl:unionOf>
                        </owl:Class>
                        </owl:complementOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </rdf:Description>

    <!-- AmericanDream: AD_Solution -->

    <rdf:Description rdf:about="http://www.semanticweb.org/PrOntoNarr#AD_Solution">
